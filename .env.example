# Public site
NEXT_PUBLIC_SITE_URL=https://www.moonyafrica.com
NEXT_PUBLIC_MOONY_APP_URL=https://application.moony-africa.com
NEXT_PUBLIC_BOOKING_URL=/contact
NEXT_PUBLIC_SUPPORT_EMAIL=contact@moonyafrica.com
NEXT_PUBLIC_WHATSAPP_URL=

# Supabase used by the website Control Center
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Control Center security
# Keep a strong founder fallback password for bootstrap/recovery, plus a random secret of at least 32 characters.
ADMIN_CONTROL_CENTER_EMAIL=founder@moonyafrica.com
ADMIN_CONTROL_CENTER_PASSWORD=
ADMIN_CONTROL_CENTER_SECRET=
# Team sessions default to 4 hours. Accepted range: 1-12 hours.
CONTROL_CENTER_SESSION_HOURS=4
# Set to true to force e-mail MFA for every team account. Individual users can also require MFA from Équipe & rôles / Mon compte.
CONTROL_CENTER_REQUIRE_MFA=false

# Internal automations
# Protects /api/cron/automations. Use a long random value and send it as Authorization: Bearer <secret> from your scheduler.
AUTOMATION_CRON_SECRET=

# Newsletter delivery + transactional security e-mails (Brevo)
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=contact@moonyafrica.com
BREVO_SENDER_NAME=MOONY Africa
